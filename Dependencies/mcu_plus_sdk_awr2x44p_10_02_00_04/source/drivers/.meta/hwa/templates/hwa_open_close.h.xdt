/*
 * HWA
 */
#include <drivers/hwa.h>

/* HWA Driver handles */
extern HWA_Handle gHwaHandle[CONFIG_HWA_NUM_INSTANCES];

/* HWA Driver open/close - can be used by application when Driver_open() and
 * Driver_close() is not used directly and app wants to control the various driver
 * open/close sequences */
void Drivers_hwaOpen(void);
void Drivers_hwaClose(void);
